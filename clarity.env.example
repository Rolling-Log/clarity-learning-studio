# Copy into 06-runtime/config/clarity.env. Never commit a real key.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CLARITY_ALLOW_PAID_API_CALLS=false
CLARITY_TEXT_PROVIDER=deepseek
CLARITY_TEXT_MODEL=deepseek-flash
CLARITY_SPEECH_PROVIDER=local
CLARITY_SPEECH_MODEL=clarity-windows-tts
OPENAI_COMPATIBLE_BASE_URL_TTS=http://127.0.0.1:4317/v1
OPENAI_COMPATIBLE_API_KEY_TTS=local-not-required
CLARITY_NOTEBOOK_URL=http://127.0.0.1:5055
